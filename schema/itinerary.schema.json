{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "days", "essentials", "links", "checks"],
  "properties": {
    "summary": { "type": "string" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "title", "items"],
        "properties": {
          "date": { "type": "string" },
          "title": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["time", "timeSource", "title", "place", "detail", "url", "kind", "transportMode", "timetableUrl"],
              "properties": {
                "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
                "timeSource": { "type": "string", "enum": ["fixed", "researched", "planned"] },
                "title": { "type": "string" },
                "place": { "type": "string" },
                "detail": { "type": "string" },
                "url": { "type": "string" },
                "kind": { "type": "string", "enum": ["move", "visit", "food", "stay", "other"] },
                "transportMode": { "type": "string", "enum": ["scheduled", "walk", "unscheduled", "none"] },
                "timetableUrl": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "essentials": { "type": "array", "items": { "type": "string" } },
    "links": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "url"], "properties": { "label": { "type": "string" }, "url": { "type": "string" } } } },
    "checks": { "type": "array", "items": { "type": "string" } }
  }
}
